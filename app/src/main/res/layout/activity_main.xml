<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_signal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/app_name"
                android:textColor="@color/paper"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingExtra="2dp"
            android:text="@string/headline"
            android:textColor="@color/paper"
            android:textSize="34sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/subhead"
            android:textColor="@color/muted"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/status_stopped"
            android:textColor="@color/signal"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/toggleButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="@color/signal"
            android:text="@string/start_sharing"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/panel_background"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/connection_title"
                android:textColor="@color/paper"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/networkLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:labelFor="@id/networkValue"
                android:text="@string/network_label"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/networkValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:backgroundTint="@color/signal_dark"
                android:fontFamily="sans-serif-medium"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLength="32"
                android:singleLine="true"
                android:textColor="@color/paper"
                android:textColorHint="@color/muted"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/passwordLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:labelFor="@id/passwordValue"
                android:text="@string/password_label"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/passwordValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:backgroundTint="@color/signal_dark"
                    android:fontFamily="sans-serif-medium"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="textVisiblePassword"
                    android:maxLength="63"
                    android:singleLine="true"
                    android:textColor="@color/paper"
                    android:textColorHint="@color/muted"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/copyPasswordButton"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:backgroundTint="@color/panel_high"
                        android:text="@string/copy"
                        android:textAllCaps="false"
                        android:textColor="@color/signal" />

                    <Button
                        android:id="@+id/refreshPasswordButton"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="@color/panel_high"
                        android:text="@string/refresh_password"
                        android:textAllCaps="false"
                        android:textColor="@color/signal" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/proxy_label"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/proxyValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/waiting_value"
                android:textColor="@color/paper"
                android:textIsSelectable="true"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/panel_background"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/connectedCountText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/connected_title"
                android:textColor="@color/paper"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/connectedDevicesValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/connected_waiting"
                android:textColor="@color/muted"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/traffic_label"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/trafficValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/traffic_zero"
                android:textColor="@color/signal"
                android:textSize="24sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/panel_background"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_title"
                android:textColor="@color/paper"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/setup_intro"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/osMacButton"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:backgroundTint="@color/signal"
                        android:text="@string/os_macos"
                        android:textAllCaps="false"
                        android:textColor="@color/ink" />

                    <Button
                        android:id="@+id/osWindowsButton"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:backgroundTint="@color/panel_high"
                        android:text="@string/os_windows"
                        android:textAllCaps="false"
                        android:textColor="@color/paper" />

                    <Button
                        android:id="@+id/osIosButton"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:backgroundTint="@color/panel_high"
                        android:text="@string/os_ios"
                        android:textAllCaps="false"
                        android:textColor="@color/paper" />

                    <Button
                        android:id="@+id/osAndroidButton"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:backgroundTint="@color/panel_high"
                        android:text="@string/os_android"
                        android:textAllCaps="false"
                        android:textColor="@color/paper" />

                    <Button
                        android:id="@+id/osLinuxButton"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:backgroundTint="@color/panel_high"
                        android:text="@string/os_linux"
                        android:textAllCaps="false"
                        android:textColor="@color/paper" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/guideTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/guide_macos_title"
                android:textColor="@color/signal"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/guideSteps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/paper"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/detailText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/technical_note"
            android:textColor="@color/muted"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
